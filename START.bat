@echo off
REM ================================================================
REM Ассистент ПБ — запускатель установки
REM ================================================================
REM Двойной клик по этому файлу — стартует установка.
REM
REM Этот .bat нужен только для того, чтобы обойти запрет Windows
REM на запуск PowerShell-скриптов и оставить окно открытым при
REM любой ошибке (чтобы можно было её прочитать).
REM ================================================================

title Ассистент ПБ — установка
chcp 65001 >nul
cd /d "%~dp0"

echo.
echo ================================================================
echo   Ассистент ПБ — установка на Windows
echo ================================================================
echo.
echo Сейчас запустится PowerShell-скрипт установки.
echo При запросах UAC ("Разрешить приложению внести изменения?")
echo нажимайте "Да" — это ставятся Ollama и Tesseract.
echo.
echo Установка займёт 30-40 минут (в основном скачивание модели ~5 ГБ).
echo НЕ ЗАКРЫВАЙТЕ это окно до появления надписи "Готово".
echo.
pause

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0bootstrap.ps1"

echo.
echo ================================================================
echo   Установка завершена (или прервана).
echo ================================================================
echo.
echo Если наверху есть красный текст с ошибкой — сфотографируйте это
echo окно и пришлите. Файл лога: bootstrap.log рядом с этим файлом.
echo.
pause
