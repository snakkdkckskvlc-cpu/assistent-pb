# --- Коммерческая тайна: не публиковать ни при каких условиях ---
# Корпус нормативных актов (может содержать внутренние правки/выжимки).
# Публичные ФЗ остаются публичными, но в этом репо мы их не выкладываем.
packages/rag/corpus/**
!packages/rag/corpus/.gitkeep

# Фирменные бланки писем компании (реквизиты, ИНН, подписанты).
apps/backend/src/fire_safety_backend/resources/templates/**
!apps/backend/src/fire_safety_backend/resources/templates/.gitkeep

