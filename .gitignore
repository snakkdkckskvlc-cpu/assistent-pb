# Референс-проекты (open-source, лежат локально для изучения; не публикуются
# в приватный репо — тяжёлые и с чужими лицензиями). Описание — в
# docs/08-references.md.
references/

# Вендоренный JDK + LanguageTool сервер (~430 МБ, скачиваются
# tools/languagetool/{start.sh не трогает, но JDK/jar — бинарники}).
# Словарь dict/spelling_global.txt — НЕ игнорировать, это наш контент.
tools/languagetool/jdk-*/
tools/languagetool/LanguageTool-*/

# Результат scripts/benchmark_models.py — зависит от железа конкретного
# запуска, не общий контент. Модельные GGUF-файлы — тоже (~5 ГБ каждый).
scripts/benchmark_results.json
scripts/modelfiles/*.gguf
