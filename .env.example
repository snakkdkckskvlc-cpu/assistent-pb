# Ассистент ПБ — пример переменных окружения.
# Скопируйте этот файл в .env и подправьте под своё окружение.

# --- Ollama ---
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b-instruct
# Для боевого сервера с 32+ ГБ RAM:
# LLM_MODEL=qwen2.5:14b-instruct-q4_K_M

LLM_TIMEOUT_SEC=900
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=4096

# --- LanguageTool ---
# Приложение само поднимает локальный сервер (tools/languagetool/), если порт
# свободен, и гасит при выходе только свой процесс. Выключать имеет смысл,
# когда сервер поднимают отдельно — службой или вручную.
LANGUAGETOOL_AUTOSTART=1

# --- Защита данных на диске (см. docs/05-quality/security.md) ---
# Шифровать загруженные и сгенерированные документы ключом учётной записи
# Windows (DPAPI). Выключать имеет смысл только при отладке.
ENCRYPT_AT_REST=1
# Сколько дней хранить рабочие файлы в data/uploads и data/outputs. 0 — не
# удалять ничего. Скачанные документы не затрагиваются.
DATA_RETENTION_DAYS=7

# --- OCR ---
# TESSERACT_CMD=/usr/local/bin/tesseract   # macOS через brew
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   # Windows

# --- RAG ---
RAG_CHROMA_DIR=./data/chroma
RAG_CORPUS_DIR=./packages/rag/corpus
RAG_EMBED_MODEL=intfloat/multilingual-e5-large
RAG_COLLECTION=legal_corpus
RAG_TOP_K=5
RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP=50
